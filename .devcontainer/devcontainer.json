{
  // Define o nome do Container 
  "name": "Projeto",

  // Indica como a imagem será criada 
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Libera as portas do cantainer
  "forwardPorts": [8080, 3306],

  // Efetua personalizções no Visual Studio Code 
  "customizations": {
    "vscode": {
      // Define as extensões que serão instaladas
      "extensions": [
        "ms-azuretools.vscode-docker",  // Docker      
        "vscjava.vscode-java-pack",  // Java           
        "vmware.vscode-spring-boot", //Spring Boot       
        "vscjava.vscode-spring-boot-dashboard", 
        "cweijan.vscode-mysql-client2",  //MySQL   
        "vscjava.vscode-spring-initializr" //iniciador de projetos Spring
      ],

      // Configurações visuais do Visual Studio Code
      "settings": {
        "workbench.colorTheme": "Dark Modern", // Tema
        "editor.fontSize": 14, // Fonte Editor 
        "terminal.integrated.fontSize": 14, // Fonte Terminal
        "java.server.launchMode": "Standard" // Força o Java a iniciar no modo "normal"
      }
    }
  },


  // Executa na criação do Container
  // Configura o MySQL
  "postCreateCommand": "/bin/bash .devcontainer/init-mysql.sh",

  // Executa toda vez que o Conatainer é executado
  // Inicia o MySQL
  "postStartCommand": "service mysql start"
}
